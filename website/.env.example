# Copy to .env.local. These are public, build-time values (they ship to the browser).
# Supabase > Project Settings > API (or the Connect dialog). Never put a secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Development only: set to true to allow the browser-only test backend in a production build.
NEXT_PUBLIC_ALLOW_LOCAL=false
