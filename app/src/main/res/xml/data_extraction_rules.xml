<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: goal history and preferences are included in cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="winterarc.db" />
        <include domain="sharedpref" path="winterarc_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="winterarc.db" />
        <include domain="sharedpref" path="winterarc_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
