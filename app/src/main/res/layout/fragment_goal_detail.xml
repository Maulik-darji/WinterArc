<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/detail_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_goal_detail"
            app:navigationContentDescription="@string/navigate_up"
            app:navigationIcon="@drawable/ic_arrow_back" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/loading"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/not_found"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/goal_not_found"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:visibility="gone" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_gutter"
                    android:paddingEnd="@dimen/screen_gutter"
                    android:paddingBottom="@dimen/space_xxl">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/icon"
                            android:layout_width="@dimen/icon_badge_large"
                            android:layout_height="@dimen/icon_badge_large"
                            android:background="@drawable/bg_icon_badge"
                            android:importantForAccessibility="no"
                            android:padding="16dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_l"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:accessibilityHeading="true"
                                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                            <TextView
                                android:id="@+id/subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawablePadding="@dimen/space_xs"
                                android:gravity="center_vertical"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Milestone waiting for a decision -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/milestone_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/wa_tertiary_container"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/milestone_banner_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/space_m"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/touch_target"
                            android:padding="@dimen/space_l"
                            android:text="@string/card_milestone_ready"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnTertiaryContainer"
                            app:drawableStartCompat="@drawable/ic_trophy"
                            app:drawableTint="?attr/colorOnTertiaryContainer" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Today's check-in -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/checkin_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:animateLayoutChanges="true"
                            android:orientation="vertical"
                            android:padding="@dimen/space_xl">

                            <TextView
                                android:id="@+id/checkin_question"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:accessibilityHeading="true"
                                android:textAppearance="?attr/textAppearanceTitleLarge" />

                            <TextView
                                android:id="@+id/checkin_target"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:importantForAccessibility="no"
                                android:textAppearance="@style/TextAppearance.WinterArc.BigNumber" />

                            <LinearLayout
                                android:id="@+id/checkin_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:accessibilityLiveRegion="polite"
                                android:background="@drawable/bg_status"
                                android:orientation="horizontal"
                                android:padding="@dimen/space_m">

                                <ImageView
                                    android:id="@+id/checkin_status_icon"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:importantForAccessibility="no" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_m"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/checkin_status_title"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                                    <TextView
                                        android:id="@+id/checkin_status_body"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="?attr/textAppearanceBodyMedium"
                                        android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/checkin_note"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_m"
                                android:drawablePadding="@dimen/space_s"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                app:drawableStartCompat="@drawable/ic_note"
                                app:drawableTint="?attr/colorOnSurfaceVariant" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_complete"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:layout_marginTop="@dimen/space_l"
                                android:text="@string/detail_action_complete"
                                app:icon="@drawable/ic_check"
                                app:iconGravity="textStart" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_log"
                                    style="@style/Widget.WinterArc.Button.Tonal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_xs"
                                    android:layout_weight="1"
                                    android:text="@string/detail_action_log"
                                    app:icon="@drawable/ic_tune" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_skip"
                                    style="@style/Widget.WinterArc.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_xs"
                                    android:layout_weight="1"
                                    android:text="@string/detail_action_skip"
                                    app:icon="@drawable/ic_bedtime" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_note"
                                    style="@style/Widget.WinterArc.Button.Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/detail_action_note"
                                    app:icon="@drawable/ic_note" />

                                <Space
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_undo"
                                    style="@style/Widget.WinterArc.Button.Text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/detail_action_undo"
                                    app:icon="@drawable/ic_undo" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Progression -->
                    <TextView
                        android:id="@+id/progression_title"
                        style="@style/Widget.WinterArc.SectionTitle"
                        android:text="@string/detail_section_progression" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/progression_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_xl">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false">

                                <LinearLayout
                                    android:id="@+id/prog_current_group"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:focusable="true"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/prog_current_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/detail_current_target"
                                        android:textAppearance="@style/TextAppearance.WinterArc.Overline" />

                                    <TextView
                                        android:id="@+id/prog_current"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.WinterArc.StatValue" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/prog_final_group"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:focusable="true"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/detail_final_target"
                                        android:textAppearance="@style/TextAppearance.WinterArc.Overline" />

                                    <TextView
                                        android:id="@+id/prog_final"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:drawablePadding="@dimen/space_xs"
                                        android:textAppearance="@style/TextAppearance.WinterArc.StatValue"
                                        app:drawableStartCompat="@drawable/ic_flag" />
                                </LinearLayout>
                            </LinearLayout>

                            <com.app.winterarc.ui.common.StepBarsView
                                android:id="@+id/prog_bars"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:layout_marginTop="@dimen/space_l" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/prog_bar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_m"
                                app:trackCornerRadius="4dp"
                                app:trackThickness="8dp" />

                            <TextView
                                android:id="@+id/prog_level"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_m"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <TextView
                                android:id="@+id/prog_remaining"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_m"
                                android:text="@string/detail_target_note"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- History -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/Widget.WinterArc.SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/detail_section_history" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_all_stats"
                            style="@style/Widget.WinterArc.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:text="@string/detail_view_stats" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/grid_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_l">

                            <com.app.winterarc.ui.common.ContributionGridView
                                android:id="@+id/grid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal" />

                            <com.app.winterarc.ui.common.GridLegendView
                                android:id="@+id/legend"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_m" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Stats -->
                    <TextView
                        style="@style/Widget.WinterArc.SectionTitle"
                        android:text="@string/detail_section_stats" />

                    <include
                        android:id="@+id/stats"
                        layout="@layout/view_stat_grid" />

                    <!-- Inspiration -->
                    <TextView
                        android:id="@+id/inspiration_title"
                        style="@style/Widget.WinterArc.SectionTitle"
                        android:text="@string/detail_section_inspiration" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/inspiration_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_xl">

                            <ImageView
                                android:id="@+id/inspiration_icon"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/inspiration_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:lineSpacingMultiplier="1.15"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <TextView
                                android:id="@+id/inspiration_attribution"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/inspiration_source"
                                style="@style/Widget.WinterArc.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="-12dp"
                                android:textAlignment="viewStart"
                                app:icon="@drawable/ic_open_in_new"
                                app:iconGravity="end" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/safety_footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:drawablePadding="@dimen/space_s"
                        android:text="@string/safety_footer"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:drawableStartCompat="@drawable/ic_shield"
                        app:drawableTint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
