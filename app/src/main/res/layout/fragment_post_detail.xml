<?xml version="1.0" encoding="utf-8"?>
<!-- The post, its threaded replies, and a reply composer pinned above the keyboard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/post_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/navigate_up"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/feed_post_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_l" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s">

        <LinearLayout
            android:id="@+id/replying_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_xs"
            android:visibility="gone">

            <TextView
                android:id="@+id/replying_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/cancel_reply"
                android:layout_width="@dimen/touch_target"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/comment_cancel_reply"
                android:padding="@dimen/space_s"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ph_close"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_xs">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/reply_layout"
                style="@style/Widget.WinterArc.TextField.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/comment_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/reply_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/send"
                style="@style/Widget.WinterArc.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:contentDescription="@string/comment_send_cd"
                android:enabled="false"
                android:paddingStart="@dimen/space_l"
                android:paddingEnd="@dimen/space_l"
                android:text="@string/comment_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
