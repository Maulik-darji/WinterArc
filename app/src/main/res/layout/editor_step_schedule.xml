<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingEnd="@dimen/screen_gutter">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:accessibilityHeading="true"
        android:text="@string/editor_step_schedule"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <TextView
        style="@style/Widget.WinterArc.SectionTitle"
        android:text="@string/editor_active_days" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/quick_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.chip.Chip
            android:id="@+id/every_day"
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_days_every_day" />

        <com.google.android.material.chip.Chip
            android:id="@+id/weekdays"
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_days_weekdays" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
        android:id="@+id/days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/days_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:accessibilityLiveRegion="assertive"
        android:text="@string/error_no_days"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rest_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:drawablePadding="@dimen/space_s"
        android:text="@string/editor_rest_days_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:drawableStartCompat="@drawable/ic_bedtime"
        app:drawableTint="?attr/colorOnSurfaceVariant" />

    <TextView
        style="@style/Widget.WinterArc.SectionTitle"
        android:text="@string/editor_reminder" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_s">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/reminder_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/editor_reminder"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reminder_time"
                style="@style/Widget.WinterArc.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_s"
                app:icon="@drawable/ic_bell" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        style="@style/Widget.WinterArc.SectionTitle"
        android:text="@string/editor_start_date" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/start_date"
        style="@style/Widget.WinterArc.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_calendar" />
</LinearLayout>
