<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/signup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_xxxl"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_xl">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_trophy"
                android:importantForAccessibility="no"
                android:padding="18dp"
                android:src="@drawable/ic_shield"
                app:tint="?attr/colorOnPrimaryContainer" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:accessibilityHeading="true"
                android:text="@string/signup_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/signup_body"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/country"
                    style="@style/Widget.WinterArc.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginTop="6dp"
                    android:paddingStart="@dimen/space_l"
                    android:paddingEnd="@dimen/space_m"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    app:icon="@drawable/ic_expand_more"
                    app:iconGravity="end"
                    app:iconTint="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phone_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:hint="@string/signup_phone_label"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_m"
                    app:boxCornerRadiusBottomStart="@dimen/radius_m"
                    app:boxCornerRadiusTopEnd="@dimen/radius_m"
                    app:boxCornerRadiusTopStart="@dimen/radius_m"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phone"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:autofillHints="phoneNational"
                        android:imeOptions="actionSend"
                        android:inputType="phone"
                        android:maxLength="20"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:accessibilityLiveRegion="assertive"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <TextView
                android:id="@+id/unavailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_status"
                android:padding="@dimen/space_l"
                android:text="@string/signup_unavailable"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone" />

            <TextView
                android:id="@+id/test_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_banner"
                android:padding="@dimen/space_m"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:drawablePadding="@dimen/space_s"
                android:text="@string/signup_why"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="?attr/colorOnSurfaceVariant" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/space_xxl" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/send"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/signup_send_code" />

            <TextView
                android:id="@+id/consent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:minHeight="@dimen/touch_target"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
