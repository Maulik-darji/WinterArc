<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_xxxl"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_xl">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/space_xl"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <com.app.winterarc.ui.common.ContributionGridView
            android:id="@+id/hero_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:accessibilityHeading="true"
            android:text="@string/auth_welcome_title"
            android:textAppearance="?attr/textAppearanceDisplaySmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/auth_welcome_body"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_xxl" />

        <include android:id="@+id/messages" layout="@layout/view_auth_messages" />

        <include
            android:id="@+id/google_button"
            layout="@layout/view_google_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_l" />

        <include layout="@layout/view_or_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_account"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/auth_create_account" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/log_in"
            style="@style/Widget.WinterArc.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/auth_log_in" />

        <TextView
            android:id="@+id/consent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:minHeight="@dimen/touch_target"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
