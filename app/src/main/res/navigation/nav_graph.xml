<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.app.winterarc.ui.onboarding.OnboardingFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_onboarding_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/wa_pop_enter"
            app:exitAnim="@anim/wa_exit"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_onboarding_to_signup"
            app:destination="@id/authWelcomeFragment"
            app:enterAnim="@anim/wa_pop_enter"
            app:exitAnim="@anim/wa_exit"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/authWelcomeFragment"
        android:name="com.app.winterarc.ui.auth.AuthWelcomeFragment"
        android:label="@string/app_name" />

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.app.winterarc.ui.auth.SignUpFragment"
        android:label="@string/auth_signup_title" />

    <fragment
        android:id="@+id/logInFragment"
        android:name="com.app.winterarc.ui.auth.LogInFragment"
        android:label="@string/auth_log_in" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.app.winterarc.ui.home.HomeFragment"
        android:label="@string/app_name" />

    <fragment
        android:id="@+id/feedFragment"
        android:name="com.app.winterarc.ui.feed.FeedFragment"
        android:label="@string/nav_feed">
        <argument
            android:name="tab"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/postDetailFragment"
        android:name="com.app.winterarc.ui.feed.PostDetailFragment"
        android:label="@string/feed_post_title">
        <argument
            android:name="postId"
            app:argType="string" />
        <argument
            android:name="focusReply"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/composePostFragment"
        android:name="com.app.winterarc.ui.feed.ComposePostFragment"
        android:label="@string/feed_compose_title">
        <!-- Set to edit an existing post. -->
        <argument
            android:name="postId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/communityDetailFragment"
        android:name="com.app.winterarc.ui.community.CommunityDetailFragment"
        android:label="@string/community_chat_title">
        <argument android:name="communityId" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/communitySettingsFragment"
        android:name="com.app.winterarc.ui.community.CommunitySettingsFragment"
        android:label="@string/community_settings_title">
        <argument android:name="communityId" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.app.winterarc.ui.community.UserProfileFragment"
        android:label="@string/user_profile_title">
        <argument android:name="userId" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/chatsFragment"
        android:name="com.app.winterarc.ui.chat.ChatsFragment"
        android:label="@string/chats_title" />

    <fragment
        android:id="@+id/chatDetailFragment"
        android:name="com.app.winterarc.ui.chat.ChatDetailFragment"
        android:label="@string/chats_title">
        <argument
            android:name="personName"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.app.winterarc.ui.profile.ProfileFragment"
        android:label="@string/profile_title" />

    <fragment
        android:id="@+id/goalEditorFragment"
        android:name="com.app.winterarc.ui.editor.GoalEditorFragment"
        android:label="@string/editor_title_new">
        <argument
            android:name="goalId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/goalDetailFragment"
        android:name="com.app.winterarc.ui.detail.GoalDetailFragment"
        android:label="@string/app_name">
        <argument
            android:name="goalId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/statsFragment"
        android:name="com.app.winterarc.ui.stats.StatsFragment"
        android:label="@string/stats_title">
        <argument
            android:name="goalId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/archiveFragment"
        android:name="com.app.winterarc.ui.archive.ArchiveFragment"
        android:label="@string/archive_title" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.app.winterarc.ui.settings.SettingsFragment"
        android:label="@string/settings_title" />

    <fragment
        android:id="@+id/legalFragment"
        android:name="com.app.winterarc.ui.legal.LegalFragment"
        android:label="@string/privacy_title">
        <argument
            android:name="doc"
            app:argType="string" />
    </fragment>
</navigation>
