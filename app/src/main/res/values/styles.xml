<?xml version="1.0" encoding="utf-8"?>
<!-- Shape, typography and component tokens. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Shapes: a tight, modern radius scale (4 / 6 / 10 / 12 / 16). -->
    <style name="ShapeAppearance.WinterArc.ExtraSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xs</item>
    </style>
    <style name="ShapeAppearance.WinterArc.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_s</item>
    </style>
    <style name="ShapeAppearance.WinterArc.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>
    <style name="ShapeAppearance.WinterArc.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_l</item>
    </style>
    <style name="ShapeAppearance.WinterArc.ExtraLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>
    <style name="ShapeAppearance.WinterArc.TopSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_xl</item>
        <item name="cornerSizeTopRight">@dimen/radius_xl</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Typography: Inter, tight tracking on large sizes, neutral tracking on body text. -->
    <style name="TextAppearance.WinterArc.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
    <style name="TextAppearance.WinterArc.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="TextAppearance.WinterArc.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">27sp</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="TextAppearance.WinterArc.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.WinterArc.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="TextAppearance.WinterArc.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>
    <style name="TextAppearance.WinterArc.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.WinterArc.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>
    <style name="TextAppearance.WinterArc.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.WinterArc.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="TextAppearance.WinterArc.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.WinterArc.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:letterSpacing">0.005</item>
    </style>
    <style name="TextAppearance.WinterArc.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <!-- Section headings: quiet sentence-case labels instead of shouty all-caps. -->
    <style name="TextAppearance.WinterArc.Overline" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.WinterArc.StatValue" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.WinterArc.BigNumber" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">44sp</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.WinterArc.BottomNavigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.WinterArc.BottomNavigation.Active">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>
    <style name="TextAppearance.WinterArc.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.WinterArc.TextView" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.BodyMedium</item>
    </style>
    <style name="Widget.WinterArc.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.BodyLarge</item>
    </style>
    <!-- Compact action inside list cards ("Complete", "Resume"). -->
    <style name="Widget.WinterArc.Button.Compact" parent="Widget.WinterArc.Button.Tonal">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.Label</item>
    </style>

    <!-- Cards: flat, hairline-outlined. -->
    <style name="Widget.WinterArc.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Large</item>
    </style>
    <style name="Widget.WinterArc.Card.Selectable" parent="Widget.WinterArc.Card">
        <item name="checkedIcon">@null</item>
        <item name="android:checkable">true</item>
        <item name="strokeColor">@color/selectable_card_stroke</item>
        <item name="cardForegroundColor">@color/selectable_card_overlay</item>
    </style>

    <!-- Buttons: 10dp rounded rectangles rather than pills. -->
    <style name="Widget.WinterArc.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Medium</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.Button</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.WinterArc.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Medium</item>
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.Button</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.WinterArc.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Medium</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.Button</item>
    </style>
    <style name="Widget.WinterArc.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Medium</item>
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.Button</item>
    </style>

    <!-- Feed: compact icon + count actions under a post or comment. -->
    <style name="Widget.WinterArc.Button.PostAction" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.BodySmall</item>
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Medium</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>
    <style name="Widget.WinterArc.FeedTabs" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabSelectedTextColor">?attr/colorOnSurface</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabTextAppearance">@style/TextAppearance.WinterArc.TitleSmall</item>
        <item name="tabRippleColor">?attr/colorControlHighlight</item>
    </style>

    <!-- Chips: 8dp corners, Inter labels. -->
    <style name="Widget.WinterArc.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Small</item>
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.Label</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
    </style>
    <style name="Widget.WinterArc.Chip.Suggestion" parent="Widget.Material3.Chip.Suggestion">
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Small</item>
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.Label</item>
    </style>
    <style name="Widget.WinterArc.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Small</item>
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.Label</item>
    </style>

    <!-- Text fields -->
    <style name="Widget.WinterArc.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Medium</item>
        <item name="boxStrokeColor">@color/text_field_stroke</item>
        <item name="hintTextAppearance">@style/TextAppearance.WinterArc.BodySmall</item>
    </style>
    <style name="Widget.WinterArc.TextField.Filled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Medium</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHighest</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.WinterArc.Medium</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
    </style>

    <style name="Widget.WinterArc.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.WinterArc.TitleLarge</item>
    </style>

    <style name="Widget.WinterArc.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.TopSheet</item>
    </style>

    <style name="Widget.WinterArc.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Medium</item>
    </style>

    <style name="Widget.WinterArc.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.WinterArc.Overline</item>
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
        <item name="android:paddingTop">@dimen/space_xl</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <!-- Menus -->
    <style name="Widget.WinterArc.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:popupElevation">6dp</item>
    </style>
    <style name="Widget.WinterArc.PopupMenu.Overflow" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:popupElevation">6dp</item>
    </style>

    <!-- Navigation bar: flat surface, rounded-rect indicator, filled icon when selected. -->
    <style name="Widget.WinterArc.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
        <item name="elevation">0dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="itemIconSize">@dimen/nav_create_icon</item>
        <item name="itemIconTint">@null</item>
        <item name="itemTextColor">@color/bottom_nav_item_tint</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.WinterArc.BottomNavigation.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.WinterArc.BottomNavigation</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.WinterArc.BottomNavigation.ActiveIndicator</item>
        <item name="itemRippleColor">@color/bottom_nav_ripple</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Widget.WinterArc.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.WinterArc.Medium</item>
    </style>
</resources>
